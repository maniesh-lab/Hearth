# No spaces around "=" and no quotes: docker run --env-file reads these lines as-is.
DISCORD_TOKEN=your_discord_bot_token_here

# FAQ (/faqload, /ask): Gemini makes the embeddings, Groq writes the answers.
# Both have free tiers. Without them the rest of the bot still works.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Time zone for /deadline dates and times (default: Asia/Kathmandu)
HEARTH_TIMEZONE=Asia/Kathmandu
